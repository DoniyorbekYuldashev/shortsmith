# Copy this file to .env and fill in the values. Never commit .env.

# OpenAI: LLM calls, embeddings and images (Phase 1+); GPT Image needs a verified organization
OPENAI_API_KEY=

# fal.ai: image-to-video hero clips, and images with IMAGE_PROVIDER=fal (Phase 2+)
FAL_KEY=

# YouTube Data API v3: trend research (Phase 5)
YOUTUBE_API_KEY=

# Telegram: daily video delivery (Phase 9)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 = placeholder images/clips (free), 0 = real paid media APIs
MOCK_MEDIA=1

# Which LLM chat() uses: "openai" (default) or "gemini" (free tier, OpenAI-compatible endpoint)
LLM_PROVIDER=openai
# Gemini: key from aistudio.google.com/apikey, in a project WITHOUT billing (= free tier)
GEMINI_API_KEY=

# Models per role (optional; empty = the provider's default). A model name decides its own provider.
#   OpenAI: gpt-5-mini for researcher/writer/director/revise, gpt-5.1 for the critic
#   Gemini: gemini-3.5-flash-lite, critic gemini-3.8-flash (fallback gemini-3.6-flash)
# SHORTSMITH_RESEARCHER_MODEL=
# SHORTSMITH_WRITER_MODEL=
# SHORTSMITH_DIRECTOR_MODEL=
# SHORTSMITH_REVISE_MODEL=
# SHORTSMITH_CRITIC_MODEL=
# OpenAI reasoning models only: minimal/low/medium/high (empty = the API's default)
OPENAI_REASONING_EFFORT=low

# OpenAI's free daily tokens for data sharing (Data controls -> Sharing on platform.openai.com shows
# whether you are eligible, which models, and how many). 1 = shared: `cost` bills text $0 within them.
OPENAI_DATA_SHARING=0
OPENAI_FREE_DAILY_TOKENS_MINI=2500000
OPENAI_FREE_DAILY_TOKENS_LARGE=250000
# Before a node would pass them (by our ledger's count): warn (default) or stop (resume after 00:00 UTC)
OPENAI_FREE_LIMIT_ACTION=warn

# The RAG index's embeddings, independent of LLM_PROVIDER: "gemini" (default) or "openai"
# (text-embedding-3-small). Each model gets its own table; switching re-embeds the 79 chunks once.
EMBEDDING_PROVIDER=gemini
# SHORTSMITH_EMBEDDING_MODEL=

# Real images (only with --real; MOCK_MEDIA=1 always makes placeholders): "openai" (default), "fal" or "mock"
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2
# low (~$0.005 an image at 1024x1536), medium (~$0.041), high (~$0.165)
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1536
# fal-ai/nano-banana ($0.0398) or fal-ai/flux/schnell (~$0.003)
FAL_IMAGE_MODEL=fal-ai/nano-banana

# The RAG knowledge base: "pgvector" (default: Postgres in Docker, `docker compose up -d db`) or "chroma"
VECTOR_STORE=pgvector
# Postgres in Docker (docker-compose.yml reads these). Make up a long random password, e.g.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
# and use the SAME one in DATABASE_URL. Optional: SHORTSMITH_DB_USER, SHORTSMITH_DB_NAME (default shortsmith).
SHORTSMITH_DB_PASSWORD=
DATABASE_URL=postgresql://shortsmith:<the same password>@127.0.0.1:5433/shortsmith
